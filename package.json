{
  "name": "@cookiemunch/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the Cookie Munch Developer API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cookiemunch-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cookie-Munch/mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cookiemunch/sdk": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "bugs": {
    "url": "https://github.com/Cookie-Munch/mcp/issues"
  },
  "homepage": "https://cookiemunch.net",
  "devDependencies": {
    "typescript": "^5.6",
    "tsup": "^8.3",
    "vitest": "^2.1",
    "@types/node": "^22"
  }
}
